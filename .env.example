# Copy this file to .env (do NOT commit .env) and fill in real values, or
# export these as real environment variables in your shell / GitHub Actions
# secrets / Streamlit Cloud secrets. Every value below is read from
# os.environ - nothing is ever hard-coded in the code.

# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Example shape (do not use this example value - it is not a real database):
# postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=
